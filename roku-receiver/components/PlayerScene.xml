<?xml version="1.0" encoding="utf-8" ?>
<component name="PlayerScene" extends="Scene">
    <interface>
        <!-- main.brs escribe aquí cada orden recibida:
             { action, url, title, format, subtitle, headers, pos, delta, key, start, index, id } -->
        <field id="request" type="assocarray" onChange="onRequest" alwaysNotify="true" />
        <!-- Estado actual; main.brs lo publica como JSON en el puerto 8061 -->
        <field id="status" type="assocarray" />
    </interface>

    <script type="text/brightscript" uri="PlayerScene.brs" />

    <children>
        <Rectangle id="background" width="1920" height="1080" color="0x101010FF" />

        <Group id="idle">
            <Label id="appName" text="FreeVideocaster"
                translation="[0, 380]" width="1920" horizAlign="center"
                font="font:LargeBoldSystemFont" color="0xFFFFFFFF" />
            <Label id="hint" text="Esperando un enlace desde el teléfono…"
                translation="[0, 470]" width="1920" horizAlign="center"
                font="font:MediumSystemFont" color="0xBBBBBBFF" />
            <Label id="ipLabel"
                translation="[0, 540]" width="1920" horizAlign="center"
                font="font:SmallSystemFont" color="0x888888FF" />
        </Group>

        <Video id="video" width="1920" height="1080" visible="false" />

        <!-- Mensajes de estado y errores, visibles encima del video -->
        <Rectangle id="statusBox" width="1920" height="140" translation="[0, 940]"
            color="0x000000C0" visible="false">
            <Label id="statusLabel" translation="[60, 20]" width="1800" height="100"
                wrap="true" maxLines="3"
                font="font:SmallSystemFont" color="0xFFFFFFFF" />
        </Rectangle>

        <Timer id="hideTimer" duration="6" />
        <Timer id="statusTimer" duration="1" repeat="true" control="start" />
    </children>
</component>
